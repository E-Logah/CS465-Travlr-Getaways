<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <header>
        <h1>Travlr Getaways</h1>

        <nav>
            <a href="/">HOME</a>
            <a href="/travel">TRAVEL</a>
            <a href="/rooms.html">ROOMS</a>
            <a href="/meals.html">MEALS</a>
            <a href="/contact.html">CONTACT</a>
        </nav>
    </header>

    <main>
    <section>
        <h2>{{heading}}</h2>

        <p>
            Explore exciting destinations and start planning your next
            getaway with Travlr Getaways.
        </p>

        <div class="travel-content">
            {{#each trips}}
                <div class="trip-card">
                    <h3>{{name}}</h3>
                    <p><strong>Code:</strong> {{code}}</p>
                    <p><strong>Length:</strong> {{length}}</p>
                    <p><strong>Start:</strong> {{start}}</p>
                    <p><strong>Resort:</strong> {{resort}}</p>
                    <p><strong>Price Per Person:</strong> ${{perPerson}}</p>
                    <p>{{description}}</p>
                </div>
            {{/each}}
        </div>
    </section>
</main>

    <footer>
        <p>&copy; 2026 Travlr Getaways. All rights reserved.</p>
    </footer>

</body>
</html>
